<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent" android:orientation="vertical">

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/universityModeToggleGroup"
		android:layout_width="match_parent"
		android:layout_height="wrap_content" android:layout_marginTop="10dp"
		android:layout_marginBottom="10dp" android:paddingStart="16dp"
		android:paddingEnd="16dp" app:singleSelection="true"
		app:selectionRequired="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_subject_wise"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/subject_wise_cgpa_title" android:checked="true"
			app:cornerRadius="20dp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_year_wise"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/year_wise_cgpa_title" app:cornerRadius="20dp" />

	</com.google.android.material.button.MaterialButtonToggleGroup>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/nestedScrollView" android:layout_width="match_parent"
		android:layout_height="match_parent" android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<LinearLayout android:layout_width="match_parent"
			android:layout_height="wrap_content" android:orientation="vertical">

			<LinearLayout android:id="@+id/subjectWiseContainer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" android:orientation="vertical">

				<LinearLayout android:id="@+id/subjectsContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" android:orientation="vertical" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/addSubjectBtn" android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp" android:text="@string/add_subject"
					style="?attr/materialButtonOutlinedStyle" app:cornerRadius="16dp" />
			</LinearLayout>

			<LinearLayout android:id="@+id/yearWiseContainer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" android:orientation="vertical"
				android:visibility="gone">

				<LinearLayout android:id="@+id/yearContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" android:orientation="vertical" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/addYearBtn" android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp" android:text="@string/add_year"
					style="?attr/materialButtonOutlinedStyle" app:cornerRadius="16dp" />
			</LinearLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/calculateBtn" android:layout_width="match_parent"
				android:layout_height="wrap_content" android:layout_marginTop="28dp"
				android:text="@string/calculate" app:cornerRadius="16dp" />

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/resultCard" android:layout_width="match_parent"
				android:layout_height="wrap_content" android:layout_marginTop="24dp"
				app:cardCornerRadius="16dp" app:cardElevation="6dp"
				android:visibility="gone">

				<LinearLayout android:layout_width="match_parent"
					android:layout_height="wrap_content" android:orientation="vertical"
					android:padding="20dp">

					<TextView android:id="@+id/resultCgpa"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/result_cgpa" android:textSize="18sp"
						android:textStyle="bold" />

					<TextView android:id="@+id/resultFinalYearCgpa"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/result_final_year_cgpa"
						android:textSize="18sp" android:textStyle="bold" />

					<TextView android:id="@+id/resultDivision"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:text="@string/result_division" android:textSize="18sp"
						android:textStyle="bold" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>

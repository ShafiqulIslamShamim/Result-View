<?xml version="1.0" encoding="utf-8" ?>
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content" app:cardCornerRadius="16dp"
	app:cardElevation="2dp" android:layout_marginBottom="10dp">

	<LinearLayout android:orientation="horizontal"
		android:gravity="center_vertical" android:padding="10dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<com.google.android.material.textfield.TextInputLayout
			style="@style/RoundedOutlinedTextInput" android:layout_width="0dp"
			android:layout_weight="1" android:layout_height="wrap_content"
			android:hint="@string/raw_cgpa">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/prevCgpaInput" android:inputType="numberDecimal"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />
		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			style="@style/RoundedOutlinedTextInput" android:layout_width="0dp"
			android:layout_weight="1" android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:hint="@string/total_credit_hind">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/prevCreditInput" android:inputType="numberDecimal"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />
		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.button.MaterialButton
			android:id="@+id/removeBtn" android:layout_marginStart="8dp"
			app:cornerRadius="12dp" android:minWidth="0dp"
			android:layout_width="40dp" android:layout_height="match_parent"
			style="?attr/materialButtonOutlinedStyle"
			android:textColor="?attr/colorError"
			app:icon="@android:drawable/ic_menu_close_clear_cancel"
			app:iconGravity="textStart" android:padding="0dp" />
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8" ?>
<resources>

	<!-- Card theme -->
	<style name="Monet.Card"
		parent="Widget.Material3.CardView.Elevated">

		<item name="android:layout_marginHorizontal">12dp</item>
		<item name="android:layout_marginVertical">4dp</item>
		<item name="cardCornerRadius">28dp</item>
	</style>

	<!-- Icon Card theme -->
	<style name="IconCard">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:background">@drawable/ic_card_background</item>
		<item name="android:tint">?colorOnSecondaryContainer</item>
		<item name="android:tintMode">src_in</item>
		<item name="android:backgroundTint">?colorSecondaryContainer</item>
		<item name="android:backgroundTintMode">src_in</item>
	</style>

	<!-- Button theme -->
	<style name="DashchanMonet.Button"
		parent="@style/Widget.Material3.Button" />

	<style name="RoundedOutlinedTextInput"
		parent="Widget.Material3.TextInputLayout.OutlinedBox">

		<item name="shapeAppearanceOverlay">@style/ShapeRounded16</item>

	</style>

	<style name="ShapeRounded16">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">16dp</item>
	</style>

	<style name="RoundedOutlinedTextInput.ExposedDropdownMenu"
		parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

		<item name="shapeAppearanceOverlay">@style/ShapeRounded16</item>

	</style>

	<style name="ToolbarTitle"
		parent="TextAppearance.Material3.TitleLarge">

		<item name="android:textStyle">bold</item>
		<item name="android:textColor">?attr/colorPrimary</item>

	</style>

	<style name="TabText"
		parent="TextAppearance.Material3.TitleMedium">
		<item name="android:textStyle">bold</item>
	</style>

</resources>
